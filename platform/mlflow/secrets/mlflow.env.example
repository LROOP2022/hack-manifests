# Порядок:
#   1. make db NAME=mlflow            -> создаст базу mlflow, пользователя и бакет mlflow,
#                                        значения будут в .local/mlflow.db.env
#   2. скопировать этот файл в mlflow.env и подставить значения оттуда
#   3. make seal PARENT=platform RESOURCE=mlflow
#
# DB_PASSWORD и S3_SECRET_KEY из .local/mlflow.db.env.
# Если в пароле есть спецсимволы, их нужно URL-кодировать (make db генерирует только hex).
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:DB_PASSWORD@postgresql.platform.svc:5432/mlflow
MLFLOW_S3_ENDPOINT_URL=http://minio.platform.svc:9000
AWS_ACCESS_KEY_ID=mlflow
AWS_SECRET_ACCESS_KEY=S3_SECRET_KEY
# basic-auth для Ingress (htpasswd, apr1/bcrypt). Сгенерировать:
#   htpasswd -nb mlflow 'ПАРОЛЬ'      (или: openssl passwd -apr1 'ПАРОЛЬ' и дописать "mlflow:" спереди)
auth=mlflow:$apr1$CHANGE-ME
